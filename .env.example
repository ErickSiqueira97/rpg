# Copie para .env e preencha só as chaves que você tem.
# Uma conta por provedor. Não coloque várias chaves separadas por vírgula.

# --- Pool grátis (LiteLLM faz fallback nesta ordem) ---
# 1. Gemini Flash-Lite. Padrão em nov/2026: gemini-3.5-flash-lite.
# gemini-2.5-flash-lite ainda existe, mas a Google só libera para contas que já o usavam.
GEMINI_API_KEY=
LLM_GEMINI_MODEL=gemini/gemini-3.5-flash-lite
# Se o streaming do Lite travar, a mesma chave tenta este Flash (também no plano grátis em nov/2026).
LLM_GEMINI_FALLBACK_MODEL=gemini/gemini-3.6-flash
LLM_FIRST_TOKEN_SECONDS=15
LLM_TIMEOUT_SECONDS=30

# 2. OpenRouter: um modelo fixo terminado em :free. Não use openrouter/free.
OPENROUTER_API_KEY=
LLM_OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free

# 3. Cloudflare Workers AI, transbordo. Llama 3.1 8B (variante -fast; a sem sufixo foi descontinuada).
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
LLM_CLOUDFLARE_MODEL=@cf/meta/llama-3.1-8b-instruct-fast

# --- Rota paga (só jogadores com plano paid) ---
# Exemplos: groq/openai/gpt-oss-20b  ou  deepseek/deepseek-chat
LLM_PAID_API_KEY=
LLM_PAID_MODEL=groq/openai/gpt-oss-20b
# LLM_PAID_API_BASE=

# --- Cota e teste ---
FREE_TURNS_PER_DAY=20
TRIAL_TURNS_PER_DAY=40
TRIAL_DAYS=7
PAID_TURNS_PER_DAY=0
PLAYER_UTC_OFFSET_HOURS=-3
# BILLING_CHECKOUT_URL=https://exemplo/assinar
# ALLOW_DEV_PLAN_TOGGLE=1

# --- Narrador e capacidade (~100 jogadores neste processo) ---
LLM_MAX_CONCURRENCY=20
LLM_MAX_WAITING=80
LLM_QUEUE_WAIT_SECONDS=8
NARRATOR_MAX_RECENT=8
NARRATOR_MAX_TOKENS=2800
SUMMARY_MAX_TOKENS=450
MODERATION=basic
# MODERATION_TERMS=termo1,termo2
# MODERATION_WEBHOOK_URL=

# RPG_LLM_FAKE=1
# RPG_DEBUG=1
DATABASE_PATH=data/rpg.sqlite
HOST=127.0.0.1
PORT=8000
